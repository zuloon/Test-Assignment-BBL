generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id
  email          String            @unique
  name           String?
  collections    Collection[]
  bookmarks      Bookmark[]
  sharesReceived CollectionShare[] @relation("CollectionShareRecipient")
  sharesCreated  CollectionShare[] @relation("CollectionShareOwner")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Collection {
  id        String            @id @default(cuid())
  name      String
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]
  shares    CollectionShare[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([ownerId])
}

model Bookmark {
  id           String      @id @default(cuid())
  url          String
  title        String
  notes        String?
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([ownerId])
  @@index([collectionId])
}

model CollectionShare {
  id               String     @id @default(cuid())
  collectionId     String
  collection       Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User       @relation("CollectionShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWithUserId String
  sharedWithUser   User       @relation("CollectionShareRecipient", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  permission       String     @default("read")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([collectionId, sharedWithUserId])
  @@index([ownerId])
  @@index([sharedWithUserId])
}
