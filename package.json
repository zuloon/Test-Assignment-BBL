{
  "name": "bbl-bookmark-manager",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
